{
  "name": "PodPulse — Ad-Free Podcast Player",
  "short_name": "PodPulse",
  "description": "Smart iOS Podcast PWA with automatic ad-skipping, offline audio downloads, and series progress tracking.",
  "start_url": "./",
  "id": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090B10",
